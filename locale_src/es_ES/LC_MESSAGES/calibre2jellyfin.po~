msgid ""
"--list columns must be one or more of \"section\", \"authors\", \"book\", "
"\"bfolder\", \"afolder\", \"subject\", \"series\", \"index\""
msgstr ""
"Las columnas de _--list_ deben ser una o más de las siguientes: « section », "
"« authors », « book », « bfolder », « afolder », « subject », « series », « "
"index »."

msgid ": display author folder"
msgstr ": mostrar carpeta del autor"

msgid ": display book folder"
msgstr ": mostrar carpeta del libro"

msgid ": display book title"
msgstr ": mostrar el título del libro"

msgid ": display list of authors"
msgstr ": mostrar lista de los autores"

msgid ": display matched subject"
msgstr ": mostrar el asunto coincidente"

msgid ": display name of construct section"
msgstr ": mostrar el nombre de la sección de construcción"

msgid ": display name of series"
msgstr ": mostrar nombre de la serie"

msgid ": display series index"
msgstr ": mostrar índice de la serie"

msgid "A required parameter (%s) is missing from configuration file \"%s\"."
msgstr ""
"Falta un parámetro obligatorio (%s) en el archivo de configuración « %s »."

msgid ""
"A utility to construct a Jellyfin ebook library from a Calibre library. "
"Configuration file \"{path}\" is required (see below)."
msgstr ""
"Una utilidad para construir una biblioteca de libros electrónicos Jellyfin a "
"partir de una biblioteca Calibre. Se requiere el archivo de configuración "
"« {path} » (ver más abajo)."

msgid "Argument --invert may only be used in conjunction with --list."
msgstr "El argumento --invert solo puede usarse junto con --list."

msgid ""
"Author folder \"%s\" does not exist or is not a directory in Calibre store "
"\"%s\"."
msgstr ""
"La carpeta del autor « %s » no existe o no es un directorio en el almacén de "
"Calibre « %s »."

msgid "Book"
msgstr "Libro"

msgid "Book attributes:  {vars}"
msgstr "Atributos del libro: {vars}"

msgid "Book metadata:    {vars}"
msgstr "Metadatos del libro: {vars}"

msgid "Book selection mode."
msgstr "Modo de selección de libros."

msgid "CONFIGURATION EXAMPLES"
msgstr "EJEMPLOS DE CONFIGURACIÓN"

msgid ""
"Calibre2jellyfin will only output a single file for the text of each book.  "
"Outputting books in multiple formats results in a suboptimal Jellyfin "
"presentation."
msgstr ""
"Calibre2jellyfin solo generará un único archivo para el texto de cada libro. "
"La producción de libros en múltiples formatos da como resultado una "
"presentación de Jellyfin subóptima."

msgid "Configuration Parameters:"
msgstr "Parámetros de configuración:"

msgid "Configuration Sections:"
msgstr "Secciones de configuración:"

msgid "Control file and directory structure of the output Jellyfin library."
msgstr ""
"Controle la estructura de archivos y directorios de la biblioteca Jellyfin "
"de salida."

msgid "Controls mangling of the metadata title element."
msgstr "Controla la manipulación del elemento de título de metadatos."

msgid "Controls mangling of the metadata title sort value."
msgstr ""
"Controla la manipulación del valor de clasificación del título de metadatos."

msgid ""
"Controls whether books are output under each of multiple authors, or only "
"under the \"primary\" author."
msgstr ""
"Controla si los libros se publican bajo cada uno de varios autores o solo "
"bajo el autor « principal »."

msgid "Could not create book symlink \"%s\": %s"
msgstr "No se pudo crear el enlace simbólico del libro « %s »: %s"

msgid ""
"Could not create book's destination folder (or a parent folder thereof) "
"\"%s\": %s"
msgstr ""
"No se pudo crear la carpeta de destino del libro (o una carpeta principal de "
"la misma) « %s »: %s"

msgid "Could not create cover image symlink \"%s\": %s"
msgstr ""
"No se pudo crear el enlace simbólico de la imagen de portada « %s »: %s"

msgid "Could not parse metadata file \"%s\": %s"
msgstr "No se pudo analizar el archivo de metadatos « %s »: %s"

msgid "Could not read configuration \"%s\": %s"
msgstr "No se pudo leer la configuración « %s »: %s"

msgid "Could not read metadata file \"%s\": %s"
msgstr "No se pudo leer el archivo de metadatos « %s »: %s"

msgid "Could not touch book symlink %s: %s"
msgstr "No se pudo acceder al enlace simbólico del libro %s: %s"

msgid "Could not touch cover image symlink %s: %s"
msgstr "No se pudo acceder al enlace simbólico de la imagen de portada %s: %s"

msgid "Could not write or overwrite metadata file \"%s\": %s"
msgstr "No se pudo escribir ni sobrescribir el archivo de metadatos « %s »: %s"

msgid "Default:"
msgstr "Por defecto:"

msgid "Disable output for additional authors."
msgstr "Deshabilitar salida para autoras adicionales."

msgid "Disable title mangling"
msgstr "Deshabilitar la manipulación de títulos"

msgid "Disable title sort mangling"
msgstr "Deshabilitar la alteración de la clasificación de títulos"

msgid "Display version string."
msgstr "Mostrar cadena de versión."

msgid ""
"Displays normal console output but makes no changes to exported libraries."
msgstr ""
"Muestra la salida normal de la consola, pero no realiza ningún cambio en las "
"bibliotecas exportadas."

msgid "Emit debug information."
msgstr "Emitir información de depuración."

msgid "Enable output for additional authors."
msgstr "Habilitar salida para autoras adicionales."

msgid "Enable title sort mangling"
msgstr "Habilitar la alteración de la clasificación de títulos"

msgid "Example:"
msgstr "Ejemplos:"

msgid "Example: --list afolder,book,series"
msgstr "Ejemplo: --list afolder,book,series"

msgid "Examples:"
msgstr "Ejemplos:"

msgid "Has no effect unless foldermode is one of:"
msgstr "No tiene efecto a menos que foldermode sea una de:"

msgid "Has no effect unless foldermode is:"
msgstr "No tiene ningún efecto a menos que el modo carpeta sea:"

msgid "If not present defaults to:"
msgstr "Si no está presente, el valor predeterminado es:"

msgid "If not specified, defaults to:"
msgstr "Si no se especifica, el valor predeterminado es:"

msgid "Inappropriate parameter value in configuration file \"%s\": %s"
msgstr ""
"Valor de parámetro inapropiado en el archivo de configuración « %s »: %s"

msgid "Incompatible arguments"
msgstr "Argumentos incompatibles"

msgid ""
"Individual lines implement OR logic. Comma delimited lists implement AND "
"logic. The example below would select any book having both \"science "
"fiction\" AND \"alien contact\" tags, OR a \"thriller\" tag."
msgstr ""
"Las líneas individuales implementan lógica OR. Las listas delimitadas por "
"comas implementan la lógica AND. El siguiente ejemplo seleccionaría "
"cualquier libro que tenga etiquetas de « ciencia ficción » Y de « contacto "
"extraterrestre », O una etiqueta de « suspenso »."

msgid ""
"Instead prints information from configuration sections and the file system "
"that is useful for curation."
msgstr ""
"En su lugar, imprime información de las secciones de configuración y del "
"sistema de archivos que resulta útil para la curación."

msgid "Invalid configuration \"%s\": %s"
msgstr "Configuración no válida « %s »: %s"

msgid ""
"Inverts the sense of the --list argument, showing those items that will not "
"be exported. "
msgstr ""
"Invierte el sentido del argumento --list, mostrando aquellos elementos que "
"no se exportarán."

msgid ""
"LIST_SPEC is a comma-delimited list of columns to include in the report."
msgstr ""
"LIST_SPEC es una lista de columnas separadas por comas que se incluirán en "
"el informe."

msgid ""
"Missing normally required <dc:creator> (i.e. author) element in metadata for "
"\"%s\""
msgstr ""
"Falta el elemento <dc:creator> (es decir, autor) normalmente requerido en "
"los metadatos para « %s »."

msgid "Missing normally required <dc:title> element in metadata for \"%s\""
msgstr ""
"Falta el elemento <dc:title> normalmente requerido en los metadatos para « "
"%s »"

msgid ""
"Multiline list of author folders within the source Calibre library.  All "
"books in these author folders will be selected and output."
msgstr ""
"Lista multilínea de carpetas de autores dentro de la biblioteca Calibre de "
"origen. Se seleccionarán y exportarán todos los libros contenidos en dichas "
"carpetas de autores."

msgid ""
"Multiline list of book file extensions, in order of preference first to "
"last, and excluding \".\" separator."
msgstr ""
"Lista multilínea de extensiones de archivos de libros, en orden de "
"preferencia del primero al último y excluyendo el separador \".\"."

msgid "Multiline list of subjects (aka tags in Calibre)."
msgstr ""
"Lista de temas de varias líneas (también conocidas como etiquetas en "
"Calibre)."

msgid ""
"Multiline parameters begin on the line following the \"parameter =\" "
"statement and must be indented."
msgstr ""
"Los parámetros multilínea comienzan en la línea que sigue a la instrucción "
"\"parameter =\" y deben tener sangría."

msgid "Must be one of:"
msgstr "Debe ser uno de:"

msgid ""
"Must be one or more of the book file extension types that Jellyfin "
"recognizes such as: azw, azw3,epub, mobi, pdf, cbz, and cbr."
msgstr ""
"Debe ser uno o más de los tipos de extensión de archivos de libros que "
"Jellyfin reconoce, como: azw, azw3, epub, mobi, pdf, cbz y cbr."

msgid "No book file of configured type was found in \"%s\""
msgstr "No se encontró ningún archivo de libro del tipo configurado en « %s »"

msgid "No cover image was found in \"%s\""
msgstr "No se encontró ninguna imagen de portada en « %s »"

msgid "No metadata was found in \"%s\""
msgstr "No se encontraron metadatos en « %s »"

msgid ""
"Note that in the case of selection by subject, if the Calibre metadata file "
"cannot be found then the book cannot be selected."
msgstr ""
"Tenga en cuenta que en el caso de la selección por tema, si no se puede "
"encontrar el archivo de metadatos de Calibre, no se podrá seleccionar el "
"libro."

msgid "Only valid in combination with --list."
msgstr "Sólo válida en combinación con --list."

msgid "Parameter:"
msgstr "Parámetro:"

msgid ""
"Parameters consist of the parameter label followed by \" = \" followed by "
"the parameter value."
msgstr ""
"Los parámetros constan de la etiqueta del parámetro seguida de \" = \" "
"seguido del valor del parámetro."

msgid "Parameters must be indented within a preceding section."
msgstr "Los parámetros deben tener sangría dentro de una sección anterior."

msgid "Prefix title with formatted series index (e.g. \"007\")"
msgstr "Anteponer al título el índice de la serie con formato (p. ej., «007»)"

msgid "Prefix title with unformatted series index (e.g. \"7\")"
msgstr "Anteponga al título el índice de la serie sin formato (p. ej., «7»)"

msgid "Processing [%s]:"
msgstr "Procesando [%s]:"

msgid "Required configuration file name and location:"
msgstr "Nombre y ubicación del archivo de configuración requerido:"

msgid "Required when selectionMode is author. Ignored otherwise."
msgstr ""
"Obligatorio cuando el modo de selección es autor. Ignorado de lo contrario."

msgid "Required when selectionMode is subject."
msgstr "Obligatorio cuando el modo de selección es subject."

msgid "Required."
msgstr "Requerida."

msgid "Sample configuration for comic books:"
msgstr "Configuración de muestra para cómics:"

msgid "Sample configuration for fiction books:"
msgstr "Configuración de muestra para libros de ficción:"

msgid "Sample configuration for nonfiction books:"
msgstr "Configuración de muestra para libros de no ficción:"

msgid "See below for configuration examples."
msgstr "Consulte a continuación ejemplos de configuración."

msgid "Suspends normal export behavior."
msgstr "Suspende el comportamiento normal de exportación."

msgid "THE CONFIGURATION FILE"
msgstr "EL ARCHIVO DE CONFIGURACIÓN"

msgid ""
"The configuration file must consist of [Construct] sections that contain "
"parameters."
msgstr ""
"El archivo de configuración debe constar de secciones [Construct] que "
"contengan parámetros."

msgid "The full path to the destination Jellyfin library."
msgstr "La ruta completa a la biblioteca Jellyfin de destino."

msgid "The full path to the source Calibre library."
msgstr "La ruta completa a la biblioteca fuente de Calibre."

msgid ""
"The output is tab-separated.  Columns must be one or more of the following:"
msgstr ""
"La salida está separada por tabuladores. Las columnas deben ser una o varias "
"de las siguientes:"

msgid ""
"The report output is sorted so there will be a pause while all configured "
"sections are processed."
msgstr ""
"El resultado del informe se ordena, por lo que habrá una pausa mientras se "
"procesan todas las secciones configuradas."

msgid "There may be multiple [Construct] sections."
msgstr "Puede haber varias secciones [Construct]."

msgid "This is for backward compatibility.  Mode 1 will likely be preferred."
msgstr ""
"Esto es por compatibilidad con versiones anteriores. Probablemente se "
"preferirá el modo 1."

msgid "This is for backward compatibility.  Mode 2 will likely be preferred."
msgstr ""
"Esto es por compatibilidad con versiones anteriores. Probablemente se "
"preferirá el modo 2."

msgid ""
"Useful to force a one-time update of all metadata files, for instance when "
"configurable metadata mangling options have changed. Normally metadata files "
"are only updated when missing or out-of-date."
msgstr ""
"Útil para forzar una actualización única de todos los archivos de metadatos, "
"por ejemplo, cuando han cambiado las opciones configurables de manipulación "
"de metadatos. Normalmente, los archivos de metadatos solo se actualizan "
"cuando faltan o están desactualizados."

msgid "Using configuration \"%s\""
msgstr "Utilizando la configuración « %s »"

msgid ""
"You may also point this to a subfolder within the Jellyfin library, for "
"instance in the case where you are creating category subfolders."
msgstr ""
"También puedes apuntar esto a una subcarpeta dentro de la biblioteca de "
"Jellyfin; por ejemplo, si estás creando subcarpetas por categorías."

msgid "[Construct] parameters: {vars}"
msgstr "Parámetros [Construct]: {vars}"

msgid "[Construct] section identifiers should not be indented."
msgstr "Los identificadores de sección [Construct] no deben tener sangría."

msgid "[Construct] section names must be uniquely named or numbered."
msgstr ""
"Los nombres de las secciones [Construct] deben tener un nombre o numerarse "
"de forma única."

msgid ""
"[Construct] section names must begin with exactly the nine letters "
"\"Construct\""
msgstr ""
"Los nombres de las secciones [Construct] deben comenzar exactamente con las "
"nueve letras « Construct »"

msgid "authorFolders must contain at least one entry"
msgstr "authorFolders debe contener al menos una entrada"

msgid "bookfiletypes must contain at least one entry"
msgstr "bookfiletypes debe contener al menos una entrada"

msgid "by"
msgstr "por"

msgid ""
"calibreStore value \"{calibre_store}\" is not a directory or does not exist"
msgstr ""
"El valor de calibreStore « {calibre_store} » no es un directorio o no existe."

msgid "excluded:"
msgstr "excluida:"

msgid "foldermode must be \"book\", \"series,book\" or \"author,series,book\""
msgstr ""
"foldermode debe ser « book », « series,book » o « author,series,book »."

msgid "jellyfinStore and calibreStore must be different locations"
msgstr "jellyfinStore y calibreStore deben estar en ubicaciones diferentes."

msgid ""
"jellyfinStore value \"{jellyfin_store}\" is not a directory or does not exist"
msgstr ""
"El valor de jellyfinStore «» {jellyfin_store} » no es un directorio o no "
"existe."

msgid "mangleMetaTitle must be 0, 1, or 2"
msgstr "mangleMetaTitle debe ser 0, 1 o 2."

msgid "of"
msgstr "de"

msgid "science fiction, alien contact"
msgstr "ciencia ficción, contacto extraterrestre"

msgid "select all books in source library"
msgstr "seleccionar todos los libros en la biblioteca fuente"

msgid "select by author folder"
msgstr "seleccionar por carpeta de autor"

msgid "select by metadata subject (aka tag)"
msgstr "seleccionar por tema de metadatos (también conocido como etiqueta)"

msgid "selected:"
msgstr "seleccionada:"

msgid "selectionMode must be \"author\", \"subject\" or \"all\""
msgstr "selectionMode debe ser « author », « subject » o « all »."

msgid "subjects must contain at least one entry"
msgstr "subjects debe contener al menos una entrada"

msgid "thriller"
msgstr "suspenso"

msgid "version {version}"
msgstr "versión {versión}"

msgid "{series} Series"
msgstr "{series} Serie"
