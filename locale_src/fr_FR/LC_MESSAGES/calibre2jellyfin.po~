#: bin/calibre2jellyfin.py:167
msgid ""
"calibreStore value \"{calibre_store}\" is not a directory or does not exist"
msgstr ""
"La valeur calibreStore « {calibre_store} » n’est pas un répertoire ou "
"n’existe pas."

#: bin/calibre2jellyfin.py:169
msgid ""
"jellyfinStore value \"{jellyfin_store}\" is not a directory or does not exist"
msgstr ""
"La valeur jellyfinStore « {jellyfin_store} » n'est pas un répertoire ou "
"n'existe pas"

#: bin/calibre2jellyfin.py:171
msgid "jellyfinStore and calibreStore must be different locations"
msgstr "jellyfinStore et calibreStore doivent être des emplacements différents"

#: bin/calibre2jellyfin.py:173
msgid "foldermode must be \"book\", \"series,book\" or \"author,series,book\""
msgstr ""
"foldermode doit être « book », « series,book » ou « author,series,book »"

#: bin/calibre2jellyfin.py:175
msgid "selectionMode must be \"author\", \"subject\" or \"all\""
msgstr "selectionMode doit être « author », « subject » ou « all »."

#: bin/calibre2jellyfin.py:177
msgid "authorFolders must contain at least one entry"
msgstr "authorFolders doit contenir au moins une entrée"

#: bin/calibre2jellyfin.py:179
msgid "subjects must contain at least one entry"
msgstr "{subjects} doit contenir au moins une entrée"

#: bin/calibre2jellyfin.py:181
msgid "bookfiletypes must contain at least one entry"
msgstr "bookfiletypes doit contenir au moins une entrée"

#: bin/calibre2jellyfin.py:183
msgid "mangleMetaTitle must be 0, 1, or 2"
msgstr "mangleMetaTitle doit être 0, 1 ou 2"

#: bin/calibre2jellyfin.py:200
msgid ""
"Author folder \"%s\" does not exist or is not a directory in Calibre store "
"\"%s\"."
msgstr ""
"Le dossier de l'auteur « %s » n'existe pas ou n'est pas un répertoire dans "
"le magasin Calibre « %s »."

#: bin/calibre2jellyfin.py:245
msgid "Processing [%s]:"
msgstr "Traitement en cours [%s] :"

#: bin/calibre2jellyfin.py:248
msgid "[Construct] parameters: {vars}"
msgstr "[Construct] paramètres : {vars}"

#: bin/calibre2jellyfin.py:336
msgid "Could not read metadata file \"%s\": %s"
msgstr "Impossible de lire le fichier de métadonnées « %s » : %s"

#: bin/calibre2jellyfin.py:339
msgid "Could not parse metadata file \"%s\": %s"
msgstr "Impossible de lire le fichier de métadonnées « %s » : %s"

#: bin/calibre2jellyfin.py:416
msgid "Could not write or overwrite metadata file \"%s\": %s"
msgstr "Impossible d'écrire ou d'écraser le fichier de métadonnées « %s » : %s"

#: bin/calibre2jellyfin.py:537 bin/calibre2jellyfin.py:543
msgid "{series} Series"
msgstr "{series} Série"

#: bin/calibre2jellyfin.py:621
msgid "Could not touch book symlink %s: %s"
msgstr "Impossible de modifier le lien symbolique %s du livre : %s"

#: bin/calibre2jellyfin.py:628
msgid "Could not create book symlink \"%s\": %s"
msgstr "Impossible de créer le lien symbolique du livre « %s » : %s"

#: bin/calibre2jellyfin.py:653
msgid "Could not touch cover image symlink %s: %s"
msgstr ""
"Impossible de modifier le lien symbolique de l'image de couverture %s : %s"

#: bin/calibre2jellyfin.py:661
msgid "Could not create cover image symlink \"%s\": %s"
msgstr ""
"Impossible de créer le lien symbolique de l'image de couverture « %s » : %s"

#: bin/calibre2jellyfin.py:736
msgid "Book {series_index} of <em>{series}</em>"
msgstr "Livre {series_index} de <em>{series}</em>"

#: bin/calibre2jellyfin.py:744
msgid "by {authors}"
msgstr "par {authors}"

#: bin/calibre2jellyfin.py:849
msgid "No book file of configured type was found in \"%s\""
msgstr "Aucun fichier livre du type configuré n'a été trouvé dans « %s »"

#: bin/calibre2jellyfin.py:853
msgid "Book attributes:  {vars}"
msgstr "Attributs du livre : {vars}"

#: bin/calibre2jellyfin.py:855
msgid "Book metadata:    {vars}"
msgstr "Métadonnées du livre : {vars}"

#: bin/calibre2jellyfin.py:858
msgid "No metadata was found in \"%s\""
msgstr "Aucune métadonnée n'a été trouvée dans « %s »"

#: bin/calibre2jellyfin.py:884
msgid "No cover image was found in \"%s\""
msgstr "Aucune image de couverture n'a été trouvée dans « %s »"

#: bin/calibre2jellyfin.py:888
msgid "Missing normally required <dc:title> element in metadata for \"%s\""
msgstr ""
"Élément <dc:title> normalement requis manquant dans les métadonnées pour « "
"%s »"

#: bin/calibre2jellyfin.py:894
msgid ""
"Missing normally required <dc:creator> (i.e. author) element in metadata for "
"\"%s\""
msgstr ""
"Élément <dc:creator> (c.-à-d. auteur) normalement requis manquant dans les "
"métadonnées pour « %s »"

#: bin/calibre2jellyfin.py:909
msgid ""
"Could not create book's destination folder (or a parent folder thereof) "
"\"%s\": %s"
msgstr ""
"Impossible de créer le dossier de destination du livre (ou un dossier parent "
"de celui-ci) « %s » : %s"

#: bin/calibre2jellyfin.py:1036
msgid "Scanning ..."
msgstr "Analyse en cours..."

#: bin/calibre2jellyfin.py:1047
msgid "excluded:"
msgstr "exclue:"

#: bin/calibre2jellyfin.py:1049
msgid "selected:"
msgstr "choisie:"

#: bin/calibre2jellyfin.py:1112
msgid ""
"A utility to construct a Jellyfin ebook library from a Calibre library. "
"Configuration file \"{path}\" is required (see below)."
msgstr ""
"Un utilitaire pour créer une bibliothèque de livres numériques Jellyfin à "
"partir d'une bibliothèque Calibre. Le fichier de configuration « {path} » "
"est requis (voir ci-dessous)."

#: bin/calibre2jellyfin.py:1122
msgid "THE CONFIGURATION FILE"
msgstr "LE FICHIER DE CONFIGURATION"

#: bin/calibre2jellyfin.py:1124
msgid "Required configuration file name and location:"
msgstr "Nom et emplacement requis du fichier de configuration :"

#: bin/calibre2jellyfin.py:1127
msgid "Configuration Sections:"
msgstr "Sections de configuration :"

#: bin/calibre2jellyfin.py:1128
msgid ""
"The configuration file must consist of [Construct] sections that contain "
"parameters."
msgstr ""
"Le fichier de configuration doit être constitué de sections [Construct] "
"contenant des paramètres."

#: bin/calibre2jellyfin.py:1129
msgid "There may be multiple [Construct] sections."
msgstr "Il peut y avoir plusieurs sections [Construct]."

#: bin/calibre2jellyfin.py:1130
msgid "[Construct] section names must be uniquely named or numbered."
msgstr ""
"Les noms des sections [Construct] doivent être uniques ou numérotés de "
"manière unique."

#: bin/calibre2jellyfin.py:1131
msgid ""
"[Construct] section names must begin with exactly the nine letters "
"\"Construct\""
msgstr ""
"Les noms de section [Construct] doivent commencer exactement par les neuf "
"lettres « Construct »."

#: bin/calibre2jellyfin.py:1132
msgid "[Construct] section identifiers should not be indented."
msgstr ""
"Les identifiants de section [Construct] ne doivent pas être mis en retrait."

#: bin/calibre2jellyfin.py:1134
msgid "Examples:"
msgstr "Exemples :"

#: bin/calibre2jellyfin.py:1140
msgid "Configuration Parameters:"
msgstr "Paramètres de configuration :"

#: bin/calibre2jellyfin.py:1141
msgid "Parameters must be indented within a preceding section."
msgstr ""
"Les paramètres doivent être en retrait par rapport à une section précédente."

#: bin/calibre2jellyfin.py:1143
msgid ""
"Parameters consist of the parameter label followed by \" = \" followed by "
"the parameter value."
msgstr ""
"Les paramètres se composent de l'étiquette du paramètre, suivie de \" = \", "
"puis de la valeur du paramètre."

#: bin/calibre2jellyfin.py:1148
msgid ""
"Multiline parameters begin on the line following the \"parameter =\" "
"statement and must be indented."
msgstr ""
"Les paramètres multilignes commencent sur la ligne suivant l'instruction \" "
"parameter = \" et doivent être mis en retrait."

#: bin/calibre2jellyfin.py:1153
msgid "See below for configuration examples."
msgstr "Voir ci-dessous pour des exemples de configuration."

#: bin/calibre2jellyfin.py:1158 bin/calibre2jellyfin.py:1164
#: bin/calibre2jellyfin.py:1177 bin/calibre2jellyfin.py:1189
#: bin/calibre2jellyfin.py:1212 bin/calibre2jellyfin.py:1230
#: bin/calibre2jellyfin.py:1251 bin/calibre2jellyfin.py:1280
#: bin/calibre2jellyfin.py:1301 bin/calibre2jellyfin.py:1320
msgid "Parameter:"
msgstr "Paramètre:"

#: bin/calibre2jellyfin.py:1160
msgid "The full path to the source Calibre library."
msgstr "Le chemin complet vers la bibliothèque source Calibre."

#: bin/calibre2jellyfin.py:1162 bin/calibre2jellyfin.py:1175
msgid "Required."
msgstr "Requis."

#: bin/calibre2jellyfin.py:1166
msgid "The full path to the destination Jellyfin library."
msgstr "Le chemin complet vers la bibliothèque Jellyfin de destination."

#: bin/calibre2jellyfin.py:1168
msgid ""
"You may also point this to a subfolder within the Jellyfin library, for "
"instance in the case where you are creating category subfolders."
msgstr ""
"Vous pouvez également le diriger vers un sous-dossier de la bibliothèque "
"Jellyfin, par exemple si vous créez des sous-dossiers par catégorie."

#: bin/calibre2jellyfin.py:1179
msgid "Control file and directory structure of the output Jellyfin library."
msgstr ""
"Contrôlez la structure des fichiers et des répertoires de la bibliothèque "
"Jellyfin de sortie."

#: bin/calibre2jellyfin.py:1181 bin/calibre2jellyfin.py:1193
#: bin/calibre2jellyfin.py:1216 bin/calibre2jellyfin.py:1241
#: bin/calibre2jellyfin.py:1284
msgid "Must be one of:"
msgstr "Doit être l'un des éléments suivants :"

#: bin/calibre2jellyfin.py:1191
msgid "Controls mangling of the metadata title element."
msgstr "Contrôle l'altération de l'élément de titre des métadonnées."

#: bin/calibre2jellyfin.py:1194
msgid "Disable title mangling"
msgstr "Désactiver la modification du titre"

#: bin/calibre2jellyfin.py:1195
msgid "Prefix title with formatted series index (e.g. \"007\")"
msgstr "Faire précéder le titre de l'index de série formaté (par ex. « 007 »)"

#: bin/calibre2jellyfin.py:1196
msgid "Prefix title with unformatted series index (e.g. \"7\")"
msgstr "Faire précéder le titre de l'index de série formaté (par ex. « 007 »)"

#: bin/calibre2jellyfin.py:1198 bin/calibre2jellyfin.py:1220
msgid "If not specified, defaults to:"
msgstr "Sauf indication contraire, la valeur par défaut est :"

#: bin/calibre2jellyfin.py:1200
msgid "This is for backward compatibility.  Mode 2 will likely be preferred."
msgstr ""
"Ceci est destiné à assurer la rétrocompatibilité. Le mode 2 sera "
"probablement privilégié."

#: bin/calibre2jellyfin.py:1204 bin/calibre2jellyfin.py:1226
msgid "Has no effect unless foldermode is one of:"
msgstr ""
"N'a aucun effet à moins que foldermode ne soit l'une des valeurs suivantes :"

#: bin/calibre2jellyfin.py:1214
msgid "Controls mangling of the metadata title sort value."
msgstr ""
"Contrôle l'altération de la valeur de tri du titre dans les métadonnées."

#: bin/calibre2jellyfin.py:1217
msgid "Disable title sort mangling"
msgstr "Désactiver l'altération du tri par titre"

#: bin/calibre2jellyfin.py:1218
msgid "Enable title sort mangling"
msgstr "Activer l'altération du tri par titre"

#: bin/calibre2jellyfin.py:1222
msgid "This is for backward compatibility.  Mode 1 will likely be preferred."
msgstr ""
"Ceci est destiné à assurer la rétrocompatibilité. Le mode 1 sera "
"probablement privilégié."

#: bin/calibre2jellyfin.py:1233
msgid ""
"Controls whether books are output under each of multiple authors, or only "
"under the \"primary\" author."
msgstr ""
"Détermine si les livres sont répertoriés sous chacun des auteurs multiples "
"ou uniquement sous l'auteur « principal »."

#: bin/calibre2jellyfin.py:1242
msgid "Disable output for additional authors."
msgstr "Désactiver l'affichage des auteurs supplémentaires."

#: bin/calibre2jellyfin.py:1243
msgid "Enable output for additional authors."
msgstr "Activer la sortie pour les auteurs supplémentaires."

#: bin/calibre2jellyfin.py:1245
msgid "Default:"
msgstr "Défaut:"

#: bin/calibre2jellyfin.py:1248
msgid "Has no effect unless foldermode is:"
msgstr "N'a aucun effet à moins que foldermode ne soit :"

#: bin/calibre2jellyfin.py:1254
msgid ""
"Multiline list of book file extensions, in order of preference first to "
"last, and excluding \".\" separator."
msgstr ""
"Liste multiligne des extensions de fichiers de livres, par ordre de "
"préférence (de la première à la dernière) et sans le séparateur « . »."

#: bin/calibre2jellyfin.py:1262
msgid ""
"Calibre2jellyfin will only output a single file for the text of each book.  "
"Outputting books in multiple formats results in a suboptimal Jellyfin "
"presentation."
msgstr ""
"Calibre2jellyfin ne génère qu'un seul fichier pour le texte de chaque livre. "
"L'exportation de livres dans plusieurs formats entraîne une présentation "
"sous-optimale dans Jellyfin."

#: bin/calibre2jellyfin.py:1272
msgid ""
"Must be one or more of the book file extension types that Jellyfin "
"recognizes such as: azw, azw3,epub, mobi, pdf, cbz, and cbr."
msgstr ""
"Il doit s'agir de l'un ou de plusieurs des types d'extensions de fichiers de "
"livres reconnus par Jellyfin, tels que : azw, azw3, epub, mobi, pdf, cbz et "
"cbr."

#: bin/calibre2jellyfin.py:1282
msgid "Book selection mode."
msgstr "Mode de sélection de livre."

#: bin/calibre2jellyfin.py:1285
msgid "select by author folder"
msgstr "Sélectionner par dossier d'auteur"

#: bin/calibre2jellyfin.py:1286
msgid "select by metadata subject (aka tag)"
msgstr "Sélectionner par sujet de métadonnées (ou étiquette)"

#: bin/calibre2jellyfin.py:1287
msgid "select all books in source library"
msgstr "Sélectionner tous les livres de la bibliothèque source"

#: bin/calibre2jellyfin.py:1289
msgid "If not present defaults to:"
msgstr "S'il est absent, la valeur par défaut est :"

#: bin/calibre2jellyfin.py:1293
msgid ""
"Note that in the case of selection by subject, if the Calibre metadata file "
"cannot be found then the book cannot be selected."
msgstr ""
"Notez que dans le cas d'une sélection par sujet, si le fichier de "
"métadonnées Calibre est introuvable, le livre ne peut pas être sélectionné."

#: bin/calibre2jellyfin.py:1304
msgid ""
"Multiline list of author folders within the source Calibre library.  All "
"books in these author folders will be selected and output."
msgstr ""
"Liste multiligne des dossiers d'auteurs au sein de la bibliothèque Calibre "
"source. Tous les livres contenus dans ces dossiers d'auteurs seront "
"sélectionnés et exportés."

#: bin/calibre2jellyfin.py:1313
msgid "Required when selectionMode is author. Ignored otherwise."
msgstr "Requis lorsque selectionMode est author. Ignoré dans le cas contraire."

#: bin/calibre2jellyfin.py:1323
msgid "Multiline list of subjects (aka tags in Calibre)."
msgstr "Liste multiligne de sujets (ou « tags » dans Calibre)."

#: bin/calibre2jellyfin.py:1331
msgid "Required when selectionMode is subject."
msgstr "Requis lorsque selectionMode est défini sur subject."

#: bin/calibre2jellyfin.py:1336
msgid ""
"Individual lines implement OR logic. Comma delimited lists implement AND "
"logic. The example below would select any book having both \"science "
"fiction\" AND \"alien contact\" tags, OR a \"thriller\" tag."
msgstr ""
"Les lignes individuelles appliquent une logique « OU ». Les listes séparées "
"par des virgules appliquent une logique « ET ». L'exemple ci-dessous "
"sélectionnerait tout livre possédant à la fois les étiquettes « science-"
"fiction » ET « contact extraterrestre », OU une étiquette « thriller »."

#: bin/calibre2jellyfin.py:1346
msgid "Example:"
msgstr "Exemples :"

#: bin/calibre2jellyfin.py:1348
msgid "science fiction, alien contact"
msgstr "science-fiction, contact avec des extraterrestres"

#: bin/calibre2jellyfin.py:1349
msgid "thriller"
msgstr "thriller"

#: bin/calibre2jellyfin.py:1352
msgid "CONFIGURATION EXAMPLES"
msgstr "EXEMPLES DE CONFIGURATION"

#: bin/calibre2jellyfin.py:1354
msgid "Sample configuration for fiction books:"
msgstr "Exemple de configuration pour les livres de fiction :"

#: bin/calibre2jellyfin.py:1377
msgid "Sample configuration for comic books:"
msgstr "Exemple de configuration pour les bandes dessinées :"

#: bin/calibre2jellyfin.py:1395
msgid "Sample configuration for nonfiction books:"
msgstr "Exemple de configuration pour les ouvrages documentaires :"

#: bin/calibre2jellyfin.py:1417
msgid "Emit debug information."
msgstr "Émettre des informations de débogage."

#: bin/calibre2jellyfin.py:1423
msgid ""
"Displays normal console output but makes no changes to exported libraries."
msgstr ""
"Affiche la sortie normale de la console mais n'apporte aucune modification "
"aux bibliothèques exportées."

#: bin/calibre2jellyfin.py:1429
msgid ""
"Inverts the sense of the --list argument, showing those items that will not "
"be exported. "
msgstr ""
"Inverse le sens de l'argument --list, en affichant les éléments qui ne "
"seront pas exportés."

#: bin/calibre2jellyfin.py:1430
msgid "Only valid in combination with --list."
msgstr "Valide uniquement en combinaison avec --list."

#: bin/calibre2jellyfin.py:1437
msgid "Suspends normal export behavior."
msgstr "Suspend le comportement d'exportation normal."

#: bin/calibre2jellyfin.py:1438
msgid ""
"Instead prints information from configuration sections and the file system "
"that is useful for curation."
msgstr ""
"À la place, il affiche des informations provenant des sections de "
"configuration et du système de fichiers qui sont utiles pour la curation."

#: bin/calibre2jellyfin.py:1439
msgid ""
"LIST_SPEC is a comma-delimited list of columns to include in the report."
msgstr ""
"LIST_SPEC est une liste de colonnes, séparées par des virgules, à inclure "
"dans le rapport."

#: bin/calibre2jellyfin.py:1440
msgid ""
"The output is tab-separated.  Columns must be one or more of the following:"
msgstr ""
"La sortie est séparée par des tabulations. Les colonnes doivent correspondre "
"à un ou plusieurs des éléments suivants :"

#: bin/calibre2jellyfin.py:1442
msgid ": display list of authors"
msgstr ": afficher la liste des auteurs"

#: bin/calibre2jellyfin.py:1443
msgid ": display name of construct section"
msgstr ": afficher le nom de la section de construction"

#: bin/calibre2jellyfin.py:1444
msgid ": display book title"
msgstr ": afficher le titre du livre"

#: bin/calibre2jellyfin.py:1445
msgid ": display book folder"
msgstr ": afficher le dossier du livre"

#: bin/calibre2jellyfin.py:1446
msgid ": display author folder"
msgstr ": afficher le dossier de l'auteur"

#: bin/calibre2jellyfin.py:1447
msgid ": display matched subject"
msgstr ": afficher le sujet correspondant"

#: bin/calibre2jellyfin.py:1448
msgid ": display name of series"
msgstr ": afficher le nom de la série"

#: bin/calibre2jellyfin.py:1449
msgid ": display series index"
msgstr ": afficher l'index de la série"

#: bin/calibre2jellyfin.py:1450
msgid ""
"The report output is sorted so there will be a pause while all configured "
"sections are processed."
msgstr ""
"Le résultat du rapport étant trié, une pause surviendra le temps que toutes "
"les sections configurées soient traitées."

#: bin/calibre2jellyfin.py:1451
msgid "Example: --list afolder,book,series"
msgstr "Exemple : --list afolder,book,series"

#: bin/calibre2jellyfin.py:1457
msgid ""
"Useful to force a one-time update of all metadata files, for instance when "
"configurable metadata mangling options have changed. Normally metadata files "
"are only updated when missing or out-of-date."
msgstr ""
"Utile pour forcer une mise à jour ponctuelle de tous les fichiers de "
"métadonnées, par exemple lorsque les options configurables de transformation "
"des métadonnées ont été modifiées. En temps normal, les fichiers de "
"métadonnées ne sont mis à jour que s'ils sont manquants ou obsolètes."

#: bin/calibre2jellyfin.py:1467
msgid "Display version string."
msgstr "Afficher la chaîne de version."

#: bin/calibre2jellyfin.py:1485
msgid "version {version}"
msgstr "version {version}"

#: bin/calibre2jellyfin.py:1489
msgid "Incompatible arguments"
msgstr "Arguments incompatibles"

#: bin/calibre2jellyfin.py:1493
msgid "Argument --invert may only be used in conjunction with --list."
msgstr "L'argument --invert ne peut être utilisé qu'avec --list."

#: bin/calibre2jellyfin.py:1501
msgid ""
"--list columns must be one or more of \"section\", \"authors\", \"book\", "
"\"bfolder\", \"afolder\", \"subject\", \"series\", \"index\""
msgstr ""
"Les colonnes de la liste doivent être une ou plusieurs des suivantes : « "
"section », « authors », « book », « bfolder », « afolder », « subject », « "
"series », « index »."

#: bin/calibre2jellyfin.py:1515
msgid "Could not read configuration \"%s\": %s"
msgstr "Impossible de lire la configuration « %s » : %s"

#: bin/calibre2jellyfin.py:1518
msgid "Invalid configuration \"%s\": %s"
msgstr "Configuration invalide « %s » : %s"

#: bin/calibre2jellyfin.py:1521
msgid "Using configuration \"%s\""
msgstr "Utilisation de la configuration « %s »"

#: bin/calibre2jellyfin.py:1539
msgid "Inappropriate parameter value in configuration file \"%s\": %s"
msgstr ""
"Valeur de paramètre incorrecte dans le fichier de configuration « %s » : %s"

#: bin/calibre2jellyfin.py:1545
msgid "A required parameter (%s) is missing from configuration file \"%s\"."
msgstr ""
"Un paramètre obligatoire (%s) est manquant dans le fichier de configuration "
"« %s »."
